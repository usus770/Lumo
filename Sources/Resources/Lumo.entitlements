<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    
    <!-- User-selected file access (read/write for library management) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Audio output (required for playback) -->
    <key>com.apple.security.device.audio-input</key>
    <false/>
    
    <!-- Apple Events / Automation (Hardened Runtime & Automation) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    
    <!-- Local loopback WebSocket server for companion browser extension -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Temporary Exception for Apple Events (Target Apps when Sandboxed) -->
    <key>com.apple.security.temporary-exception.apple-events</key>
    <array>
        <string>com.apple.Music</string>
        <string>com.spotify.client</string>
        <string>com.google.Chrome</string>
        <string>com.apple.Safari</string>
        <string>com.brave.Browser</string>
        <string>com.microsoft.edgemac</string>
        <string>company.thebrowser.Browser</string>
        <string>org.videolan.vlc</string>
    </array>
</dict>
</plist>
